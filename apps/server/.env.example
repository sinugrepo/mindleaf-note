# Mindleaf Server (backend) environment variables
# Generate secrets with: openssl rand -base64 32

# PostgreSQL connection string
DATABASE_URL=postgres://mindleaf:devpw@localhost:5432/mindleaf

# Session signing secret (HMAC for cookie values)
SESSION_SECRET=replace-me-with-openssl-rand-base64-32

# AES-256-GCM master encryption key (base64-encoded 32 bytes)
MASTER_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32

# S3-compatible object storage (Cloudflare R2 in prod, MinIO in dev)
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY=mindleaf
R2_SECRET_KEY=devpw
R2_BUCKET=mindleaf-dev
R2_REGION=auto

# CORS allowed origin (the frontend URL)
ALLOWED_ORIGIN=http://localhost:3000

# Server bind address (keep loopback-only behind Caddy in production)
HOST=127.0.0.1

# Server port
PORT=8787
